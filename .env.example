# Copy this file to .env.local and fill in your keys

# Supabase (from supabase.com project settings)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (from stripe.com dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend (from resend.com)
RESEND_API_KEY=your_resend_api_key

# OpenCode Zen API (free DeepSeek V4 Flash for AI lead filtering)
ZEN_API_KEY=your_zen_api_key

# Reddit API (for scraping r/forhire, r/jobbit, r/remotejs, r/freelance_forhire)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Optional job aggregators — each source is skipped automatically if its key is
# not set, so these are all optional. Add them to widen the scrape.
# Adzuna (free): https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Jooble (free): https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key
# Findwork (free): https://findwork.dev/api
FINDWORK_API_KEY=your_findwork_api_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret — set this in Vercel so only the scheduler can trigger scrapes.
# Vercel automatically sends it as `Authorization: Bearer <CRON_SECRET>` on cron runs.
CRON_SECRET=your_long_random_string

# Admin email (for accessing /admin)
NEXT_PUBLIC_ADMIN_EMAIL=your_email@example.com
