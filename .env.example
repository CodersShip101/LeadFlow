# Copy this file to .env.local and fill in your keys

# Supabase (from supabase.com project settings)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (from stripe.com dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend (from resend.com)
RESEND_API_KEY=your_resend_api_key

# DeepSeek AI via OpenRouter (for AI lead filtering)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=deepseek/deepseek-v4-flash

# Reddit API (for scraping r/forhire)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email (for accessing /admin)
NEXT_PUBLIC_ADMIN_EMAIL=your_email@example.com
